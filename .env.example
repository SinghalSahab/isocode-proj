# Environment Variables Template
# Copy to .env and fill in values for your environment.

# Database Connections
# Local Docker Postgres (default) or Neon Pooled URL (contains -pooler) for serverless runtime
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fmcg_distributor?schema=public"

# Neon Direct URL (non-pooled) for migrations. On local Docker, same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fmcg_distributor?schema=public"

# Dedicated test database (must be local Postgres, never neon.tech)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fmcg_distributor_test?schema=public"

# Authentication
# Secret key used by `jose` to sign session JWTs (generate 32+ char secret for production)
SESSION_SECRET="demo-insecure-secret-key-change-in-production-min-32-chars-long"

# Demo OTP shown on login screen banner for reviewers (default: 123456)
DEMO_OTP="123456"

# AI Order Capture (Gemini)
# Optional: if omitted or offline, pipeline falls back to the deterministic Hinglish rule matcher
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
